{
  "name": "fixeo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @fixeo/shared run build && pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --filter @fixeo/shared run build && pnpm --recursive --filter \"./apps/*\" run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
