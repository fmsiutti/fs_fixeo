# Copiar a .env y completar. Nunca commitear .env con valores reales.

NODE_ENV=development
PORT=3000

# Postgres (docker-compose expone 5432 con estas credenciales de desarrollo)
DATABASE_URL=postgresql://fixeo:fixeo@localhost:5432/fixeo?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Origen de apps/web permitido por CORS (con credenciales, para la cookie de refresh)
CORS_ORIGIN=http://localhost:5173

# JWT (requerida: la api no arranca sin este valor). Los refresh tokens son
# opacos (randomBytes + hash en base), no JWT, por eso no hay JWT_REFRESH_SECRET.
JWT_ACCESS_SECRET=

# Twilio Verify (OTP). Driver "log" (default) genera el codigo en los logs, sin credenciales.
# Driver "twilio" usa las credenciales reales de abajo.
# Con el driver "log", el codigo 000000 siempre funciona para cualquier telefono
# (no hace falta ir a leer el log): nunca se usa este driver en produccion.
TWILIO_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Almacenamiento de fotos de pedido. Driver "log" (default) guarda en disco
# local (apps/api/uploads-dev/, servida como estatica solo en este driver).
# Driver "s3" sube al bucket S3-compatible de abajo (S3 o R2).
STORAGE_DRIVER=log
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# Bucket separado y privado, solo para documentos de verificacion (DNI,
# matricula). Nunca el mismo valor que S3_BUCKET. Con driver "log" los
# documentos van a apps/api/uploads-dev-privado/, que nunca se sirve como
# estatica. El bucket real de produccion debe configurarse sin lectura
# publica (el codigo no puede forzar la ACL del bucket).
S3_BUCKET_DOCUMENTOS=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web Push (VAPID). "log" (default) solo loguea el envio; "vapid" usa las
# claves de abajo contra el navegador real.
WEB_PUSH_DRIVER=log
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=

# apps/web (Vite): URL de la api para el cliente
VITE_API_URL=http://localhost:3000
