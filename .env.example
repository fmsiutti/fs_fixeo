# Copiar a .env y completar. Nunca commitear .env con valores reales.

NODE_ENV=development
PORT=3000

# Postgres (docker-compose expone 5432 con estas credenciales de desarrollo)
DATABASE_URL=postgresql://fixeo:fixeo@localhost:5432/fixeo?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Twilio Verify (OTP). Sin credenciales, la api usa el driver "log" en desarrollo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Almacenamiento S3-compatible (S3 o R2)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web Push (VAPID)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=

# apps/web (Vite): URL de la api para el cliente
VITE_API_URL=http://localhost:3000
