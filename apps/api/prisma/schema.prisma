generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum RolUsuario {
  cliente
  profesional
  moderador
  soporte

  @@map("rol_usuario")
}

enum EstadoUsuario {
  activo
  suspendido
  eliminado

  @@map("estado_usuario")
}

model Usuario {
  id           String        @id @default(uuid())
  telefono     String        @unique
  nombre       String?
  apellido     String?
  email        String?
  fotoUrl      String?       @map("foto_url")
  rolActivo    RolUsuario?   @map("rol_activo")
  estado       EstadoUsuario @default(activo)
  creadoEn     DateTime      @default(now()) @map("creado_en")
  ultimoAcceso DateTime?     @map("ultimo_acceso")

  refreshTokens RefreshToken[]

  @@map("usuario")
}

model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  tokenHash  String    @unique @map("token_hash")
  creadoEn   DateTime  @default(now()) @map("creado_en")
  expiraEn   DateTime  @map("expira_en")
  revocadoEn DateTime? @map("revocado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_token")
}

enum ExigenciaMatricula {
  obligatoria
  recomendada
  no_exigida

  @@map("exigencia_matricula")
}

model Categoria {
  id                String             @id @default(uuid())
  nombre            String
  slug              String             @unique
  subcategorias     String[]
  preguntasGuia     String[]           @default([]) @map("preguntas_guia")
  requiereMatricula ExigenciaMatricula @map("requiere_matricula")
  activa            Boolean            @default(true)

  @@map("categoria")
}

model Barrio {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(false)

  @@map("barrio")
}

model ParametroNegocio {
  id    String @id @default(uuid())
  clave String @unique
  valor Json

  @@map("parametro_negocio")
}
