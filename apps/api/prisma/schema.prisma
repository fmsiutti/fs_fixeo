generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum RolUsuario {
  cliente
  profesional
  moderador
  soporte

  @@map("rol_usuario")
}

enum EstadoUsuario {
  activo
  suspendido
  eliminado

  @@map("estado_usuario")
}

model Usuario {
  id           String        @id @default(uuid())
  telefono     String        @unique
  nombre       String?
  apellido     String?
  email        String?
  fotoUrl      String?       @map("foto_url")
  rolActivo    RolUsuario?   @map("rol_activo")
  estado       EstadoUsuario @default(activo)
  creadoEn     DateTime      @default(now()) @map("creado_en")
  ultimoAcceso DateTime?     @map("ultimo_acceso")

  refreshTokens     RefreshToken[]
  pedidos           Pedido[]
  perfilProfesional PerfilProfesional?
  accesosDocumento  AccesoDocumento[]
  denuncias         Denuncia[]
  reseniasEscritas  Resenia[]

  @@map("usuario")
}

model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  tokenHash  String    @unique @map("token_hash")
  creadoEn   DateTime  @default(now()) @map("creado_en")
  expiraEn   DateTime  @map("expira_en")
  revocadoEn DateTime? @map("revocado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_token")
}

enum ExigenciaMatricula {
  obligatoria
  recomendada
  no_exigida

  @@map("exigencia_matricula")
}

model Categoria {
  id                String             @id @default(uuid())
  nombre            String
  slug              String             @unique
  subcategorias     String[]
  preguntasGuia     String[]           @default([]) @map("preguntas_guia")
  requiereMatricula ExigenciaMatricula @map("requiere_matricula")
  activa            Boolean            @default(true)

  pedidos Pedido[]
  oficios OficioProfesional[]

  @@map("categoria")
}

model Barrio {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(false)

  direcciones Direccion[]
  pedidos     Pedido[]

  @@map("barrio")
}

model ParametroNegocio {
  id    String @id @default(uuid())
  clave String @unique
  valor Json

  @@map("parametro_negocio")
}

enum TipoPropiedad {
  casa
  departamento
  otro

  @@map("tipo_propiedad")
}

model Direccion {
  id            String        @id @default(uuid())
  calle         String
  numero        String
  piso          String?
  depto         String?
  tipoPropiedad TipoPropiedad @map("tipo_propiedad")
  barrioId      String        @map("barrio_id")
  lat           Float
  lng           Float
  creadoEn      DateTime      @default(now()) @map("creado_en")

  barrio  Barrio   @relation(fields: [barrioId], references: [id], onDelete: Restrict)
  pedidos Pedido[]

  @@index([barrioId])
  @@map("direccion")
}

enum EstadoPedido {
  borrador
  en_revision
  publicado
  con_postulaciones
  contacto_habilitado
  cerrado
  expirado
  cancelado
  bloqueado

  @@map("estado_pedido")
}

enum Urgencia {
  emergencia
  esta_semana
  sin_apuro

  @@map("urgencia")
}

// docs/dominio.md §7.5/§12 D4: las 4 opciones fijas de CL-11 (ficha de
// cierre). Antes era String? libre porque el documento original no lo
// modelaba; ahora que CL-11 lo implementa, es vocabulario controlado como
// el resto de los enums del dominio.
enum Desenlace {
  lo_hizo_este_profesional
  lo_hizo_otro
  ya_no_lo_necesito
  todavia_no_lo_resolvi

  @@map("desenlace")
}

model Pedido {
  id                    String       @id @default(uuid())
  clienteId             String       @map("cliente_id")
  categoriaId           String       @map("categoria_id")
  subcategoria          String?
  descripcion           String
  respuestasGuia        Json?        @map("respuestas_guia")
  urgencia              Urgencia
  franjas               String[]     @default([])
  direccionId           String       @map("direccion_id")
  barrioId              String       @map("barrio_id")
  lat                   Float
  lng                   Float
  estado                EstadoPedido @default(borrador)
  publicadoEn           DateTime?    @map("publicado_en")
  expiraEn              DateTime?    @map("expira_en")
  cierreAutomaticoEn    DateTime?    @map("cierre_automatico_en")
  desenlacePostergado   Boolean      @default(false) @map("desenlace_postergado")
  desenlace             Desenlace?
  motivoModeracion      String?      @map("motivo_moderacion")
  vistas                Int          @default(0)
  cantidadPostulaciones Int          @default(0) @map("cantidad_postulaciones")
  cantidadContactos     Int          @default(0) @map("cantidad_contactos")
  creadoEn              DateTime     @default(now()) @map("creado_en")

  cliente       Usuario       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  categoria     Categoria     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  direccion     Direccion     @relation(fields: [direccionId], references: [id], onDelete: Restrict)
  barrio        Barrio        @relation(fields: [barrioId], references: [id], onDelete: Restrict)
  fotos         FotoPedido[]
  postulaciones Postulacion[]
  contactos     Contacto[]
  resenias      Resenia[]

  @@index([clienteId])
  @@index([estado])
  @@index([clienteId, estado])
  @@map("pedido")
}

model FotoPedido {
  id       String   @id @default(uuid())
  pedidoId String   @map("pedido_id")
  url      String
  orden    Int
  subidaEn DateTime @default(now()) @map("subida_en")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("foto_pedido")
}

// docs/dominio.md §10/§11: "todo evento con categoria, zona y rol". Sin
// relaciones ni onDelete hacia Usuario/Pedido a proposito: es un registro de
// analitica, tiene que sobrevivir aunque se borre la cuenta o el pedido (regla
// de negocio #9: los datos se anonimizan, no se pierde la metrica). Por eso
// mismo, `usuarioId` no se limpia solo: el slice de eliminacion de cuenta
// tiene que ponerlo en NULL a mano (docs/dominio.md §13).
model EventoAnalitico {
  id        String   @id @default(uuid())
  tipo      String
  categoria String?
  zona      String?
  rol       String?
  usuarioId String?  @map("usuario_id")
  pedidoId  String?  @map("pedido_id")
  metadata  Json?
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@index([tipo])
  @@map("evento_analitico")
}

enum EstadoVerificacion {
  pendiente
  aprobada
  rechazada

  @@map("estado_verificacion")
}

enum EstadoMatricula {
  no_requerida
  pendiente
  validada
  rechazada
  vencida

  @@map("estado_matricula")
}

enum TipoZonaCobertura {
  barrios
  radio

  @@map("tipo_zona_cobertura")
}

enum TipoVerificacion {
  identidad
  matricula

  @@map("tipo_verificacion")
}

model PerfilProfesional {
  id                 String             @id @default(uuid())
  usuarioId          String             @unique @map("usuario_id")
  presentacion       String?
  aniosExperiencia   Int?               @map("anios_experiencia")
  estadoVerificacion EstadoVerificacion @default(pendiente) @map("estado_verificacion")
  verificadoEn       DateTime?          @map("verificado_en")
  pausado            Boolean            @default(false)
  tasaRespuesta      Float?             @map("tasa_respuesta")
  promedioResenias   Float?             @map("promedio_resenias")
  cantidadResenias   Int                @default(0) @map("cantidad_resenias")
  trabajosCerrados   Int                @default(0) @map("trabajos_cerrados")
  creadoEn           DateTime           @default(now()) @map("creado_en")

  usuario           Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  oficios           OficioProfesional[]
  zonaCobertura     ZonaCobertura?
  verificaciones    Verificacion[]
  postulaciones     Postulacion[]
  plantillasMensaje PlantillaMensaje[]
  resenias          Resenia[]

  // docs/dominio.md §6: un profesional entra al matching y al feed solo si
  // "su verificacion esta aprobada y su perfil no esta pausado". Ambos
  // filtros se aplican juntos en cada consulta de coincidencia, antes del
  // join con OficioProfesional; para el tamano de un piloto un solo indice
  // compuesto alcanza (no hace falta uno por columna).
  @@index([estadoVerificacion, pausado])
  @@map("perfil_profesional")
}

model OficioProfesional {
  id               String          @id @default(uuid())
  perfilId         String          @map("perfil_id")
  categoriaId      String          @map("categoria_id")
  subcategorias    String[]        @default([])
  matriculaNumero  String?         @map("matricula_numero")
  matriculaEnte    String?         @map("matricula_ente")
  matriculaEstado  EstadoMatricula @default(no_requerida) @map("matricula_estado")
  matriculaVenceEn DateTime?       @map("matricula_vence_en")
  creadoEn         DateTime        @default(now()) @map("creado_en")

  perfil         PerfilProfesional @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  categoria      Categoria         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  verificaciones Verificacion[]

  @@unique([perfilId, categoriaId])
  @@index([perfilId])
  // Slice 5: buscar coincidentes de un pedido (o armar el feed de un
  // profesional) filtra por categoria sola, sin perfilId.
  @@index([categoriaId])
  @@map("oficio_profesional")
}

model ZonaCobertura {
  id            String            @id @default(uuid())
  perfilId      String            @unique @map("perfil_id")
  tipo          TipoZonaCobertura
  barrioIds     String[]          @default([]) @map("barrio_ids")
  centroLat     Float?            @map("centro_lat")
  centroLng     Float?            @map("centro_lng")
  radioKm       Float?            @map("radio_km")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")

  perfil PerfilProfesional @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@map("zona_cobertura")
}

model Verificacion {
  id            String             @id @default(uuid())
  perfilId      String             @map("perfil_id")
  tipo          TipoVerificacion
  oficioId      String?            @map("oficio_id")
  documentos    String[]
  estado        EstadoVerificacion @default(pendiente)
  revisadaPor   String?            @map("revisada_por")
  motivoRechazo String?            @map("motivo_rechazo")
  enviadaEn     DateTime           @default(now()) @map("enviada_en")
  revisadaEn    DateTime?          @map("revisada_en")

  perfil  PerfilProfesional  @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  oficio  OficioProfesional? @relation(fields: [oficioId], references: [id], onDelete: Restrict)
  accesos AccesoDocumento[]

  @@index([perfilId])
  @@index([estado])
  @@map("verificacion")
}

// Auditoria de accesos a documentos de verificacion (docs/dominio.md §13,
// apps/api/CLAUDE.md "cada acceso se registra"). A diferencia de
// EventoAnalitico, aca el moderador es un usuario autenticado real y el
// registro tiene valor legal, asi que se agrega la FK a Usuario con
// onDelete Restrict: no se puede borrar una cuenta de moderador mientras
// tenga accesos auditados, y nunca se pierde el rastro de quien vio que.
model AccesoDocumento {
  id             String   @id @default(uuid())
  verificacionId String   @map("verificacion_id")
  moderadorId    String   @map("moderador_id")
  accedidoEn     DateTime @default(now()) @map("accedido_en")

  verificacion Verificacion @relation(fields: [verificacionId], references: [id], onDelete: Cascade)
  moderador    Usuario      @relation(fields: [moderadorId], references: [id], onDelete: Restrict)

  @@index([verificacionId])
  @@map("acceso_documento")
}

// Sin FK a Usuario a proposito, mismo criterio que EventoAnalitico: la
// tabla de notificaciones no debe depender de que la cuenta exista para
// siempre (docs/dominio.md §13, anonimizacion al eliminar cuenta).
model Notificacion {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tipo      String
  objetoId  String?   @map("objeto_id")
  leidaEn   DateTime? @map("leida_en")
  creadaEn  DateTime  @default(now()) @map("creada_en")

  // apps/api/CLAUDE.md: "la deduplicacion de avisos usa una clave unica en
  // notificacion (tipo + objeto_id + usuario_id)".
  @@unique([usuarioId, tipo, objetoId])
  @@index([usuarioId])
  @@map("notificacion")
}

enum TipoObjetoDenuncia {
  pedido
  postulacion
  perfil
  resenia

  @@map("tipo_objeto_denuncia")
}

enum EstadoDenuncia {
  pendiente
  resuelta
  descartada

  @@map("estado_denuncia")
}

// docs/dominio.md §11/§15: canal de denuncia en perfil, pedido y
// postulacion (y resenia, §8). objetoId no tiene FK a proposito, mismo
// espiritu que EventoAnalitico: es polimorfico (pedido, postulacion,
// perfil_profesional o resenia segun tipoObjeto) y no hay una unica tabla
// destino a la que apuntar, asi que la integridad referencial la valida el
// service, no la base. reportanteId si tiene FK con onDelete Restrict,
// mismo criterio que AccesoDocumento.moderadorId: es un registro con valor
// de auditoria/moderacion, no se puede perder ni borrar en cascada al
// eliminar la cuenta.
model Denuncia {
  id           String             @id @default(uuid())
  reportanteId String             @map("reportante_id")
  tipoObjeto   TipoObjetoDenuncia @map("tipo_objeto")
  objetoId     String             @map("objeto_id")
  motivo       String
  detalle      String?
  estado       EstadoDenuncia     @default(pendiente)
  resueltaEn   DateTime?          @map("resuelta_en")
  // Adicion tecnica del mismo tipo que las que lista docs/dominio.md §11
  // bajo "Campos agregados a lo que modela el documento": el documento no
  // la lista, pero sin ella no se puede ordenar ni paginar la futura cola
  // de moderacion de denuncias (slice 9).
  creadoEn     DateTime           @default(now()) @map("creado_en")

  reportante Usuario @relation(fields: [reportanteId], references: [id], onDelete: Restrict)

  @@index([tipoObjeto, objetoId])
  @@index([estado])
  @@map("denuncia")
}

enum EstadoPostulacion {
  enviada
  vista
  seleccionada
  descartada
  retirada
  caducada

  @@map("estado_postulacion")
}

// docs/dominio.md §11: "un profesional solo puede tener una postulacion viva
// por pedido" no esta escrito asi en el documento, pero volver a postularse
// despues de retirarse no esta modelado en este slice; @@unique lo impide a
// nivel de base hasta que haga falta lo contrario.
model Postulacion {
  id                 String            @id @default(uuid())
  pedidoId           String            @map("pedido_id")
  profesionalId      String            @map("profesional_id")
  mensaje            String
  estimacionMin      Int?              @map("estimacion_min")
  estimacionMax      Int?              @map("estimacion_max")
  estimacionADefinir Boolean           @default(false) @map("estimacion_a_definir")
  disponibilidad     String?
  estado             EstadoPostulacion @default(enviada)
  enviadaEn          DateTime          @default(now()) @map("enviada_en")
  vistaEn            DateTime?         @map("vista_en")
  // Adicion tecnica del mismo tipo que las que lista docs/dominio.md §11 bajo
  // "Campos agregados a lo que modela el documento": hace falta para calcular
  // la ventana de descarte reversible de 24 h (parametro_negocio
  // "descarte_reversible_horas").
  descartadaEn       DateTime?         @map("descartada_en")

  pedido      Pedido            @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  profesional PerfilProfesional @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  contacto    Contacto?

  @@unique([pedidoId, profesionalId])
  @@index([pedidoId])
  @@index([profesionalId, enviadaEn])
  @@index([estado])
  @@map("postulacion")
}

// docs/dominio.md §3/§11: cada seleccion crea un Contacto (hasta 3 por
// pedido, D2/D3), pero la misma postulacion no se puede elegir dos veces:
// de ahi el @unique en postulacionId. onDelete Restrict hacia Postulacion
// (no Cascade) porque las postulaciones nunca se borran, solo cambian de
// estado (docs/dominio.md §11), asi que perder el Contacto al borrar la
// postulacion no deberia poder pasar nunca; si algun dia se permite borrar
// postulaciones, esta restriccion obliga a decidir que pasa con el contacto
// primero.
model Contacto {
  id                   String    @id @default(uuid())
  pedidoId             String    @map("pedido_id")
  postulacionId        String    @unique @map("postulacion_id")
  orden                Int
  habilitadoEn         DateTime  @default(now()) @map("habilitado_en")
  abiertoWhatsappEn    DateTime? @map("abierto_whatsapp_en")
  confirmadoPorCliente Boolean?  @map("confirmado_por_cliente")

  pedido      Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  postulacion Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Restrict)
  resenia     Resenia?

  @@unique([pedidoId, orden])
  @@index([pedidoId])
  @@map("contacto")
}

// docs/dominio.md §8/§11: una resenia por contacto (contactoId es unico),
// del cliente cuyo pedido llego a contacto_habilitado, del profesional que
// declaro que hizo el trabajo. onDelete Restrict hacia Contacto, Perfil
// Profesional y Usuario con el mismo criterio que Contacto -> Postulacion y
// AccesoDocumento.moderadorId: son registros con valor de auditoria/negocio
// (una resenia negativa no se borra a pedido del profesional, docs/dominio.md
// §8) que no pueden desaparecer en cascada al borrar el contacto, el perfil o
// la cuenta. onDelete Cascade hacia Pedido, mismo criterio que FotoPedido: la
// resenia no tiene sentido sin el pedido que la origino.
model Resenia {
  id                   String   @id @default(uuid())
  pedidoId             String   @map("pedido_id")
  contactoId           String   @unique @map("contacto_id")
  profesionalId        String   @map("profesional_id")
  clienteId            String   @map("cliente_id")
  puntaje              Int
  atributos            String[] @default([])
  comentario           String?
  montoDeclarado       Int?     @map("monto_declarado")
  respuestaProfesional String?  @map("respuesta_profesional")
  publicadaEn          DateTime @default(now()) @map("publicada_en")

  pedido      Pedido            @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  contacto    Contacto          @relation(fields: [contactoId], references: [id], onDelete: Restrict)
  profesional PerfilProfesional @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  cliente     Usuario           @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([profesionalId])
  @@index([pedidoId])
  @@map("resenia")
}

model PlantillaMensaje {
  id       String   @id @default(uuid())
  perfilId String   @map("perfil_id")
  texto    String
  creadoEn DateTime @default(now()) @map("creado_en")

  perfil PerfilProfesional @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([perfilId])
  @@map("plantilla_mensaje")
}
